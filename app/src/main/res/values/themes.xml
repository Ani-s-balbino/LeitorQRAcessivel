<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LeitorQR" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/azul_principal</item>
        <item name="colorOnPrimary">@color/sobre_azul_principal</item>
        <item name="colorPrimaryContainer">@color/azul_container</item>
        <item name="colorOnPrimaryContainer">@color/sobre_azul_container</item>
        <item name="colorSecondaryContainer">@color/azul_container</item>
        <item name="colorOnSecondaryContainer">@color/sobre_azul_container</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorSurfaceVariant">@color/azul_container</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="colorError">@color/erro</item>
        <item name="colorOnError">@color/sobre_erro</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="shapeAppearanceCornerMedium">@style/Forma.Arredondada</item>
    </style>

    <style name="Forma.Arredondada" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Textos -->
    <style name="Texto.Titulo" parent="">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Corpo" parent="">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Texto.Apoio" parent="">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Cartões -->
    <style name="Cartao" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/contorno</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Botões: alvo de toque de 52dp (mínimo recomendado: 48dp), texto 16sp, cantos bem arredondados -->
    <style name="Botao.Principal" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Botao.Secundario" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Botao.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/contorno</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>
</resources>
