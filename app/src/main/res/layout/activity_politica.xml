<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Voltar fica no início da tela -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoVoltarPolitica"
            style="@style/Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/botao_voltar"
            app:icon="@drawable/ic_voltar" />

        <TextView android:focusable="true"
            android:id="@+id/tituloPolitica"
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/titulo_politica" />

        <TextView android:focusable="true"
            style="@style/Texto.Apoio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/politica_atualizacao" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:focusable="true"
                    android:id="@+id/cabecalhoPrivacidade"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/politica_privacidade_titulo"
                    android:textSize="20sp" />

                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_priv_1" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_priv_2" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_priv_3" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_priv_4" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_priv_5" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_priv_6" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_priv_7" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:focusable="true"
                    android:id="@+id/cabecalhoTermos"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/politica_termos_titulo"
                    android:textSize="20sp" />

                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_termos_1" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_termos_2" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_termos_3" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_termos_4" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_termos_5" />
                <TextView android:focusable="true" style="@style/Texto.Corpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/politica_termos_6" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
