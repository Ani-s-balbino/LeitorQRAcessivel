<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Voltar fica no início da tela, para sair rápido -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoVoltar"
            style="@style/Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/botao_voltar"
            app:icon="@drawable/ic_voltar" />

        <TextView android:focusable="true"
            android:id="@+id/textoTituloConfiguracoes"
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/titulo_configuracoes" />

        <!-- Feedback durante a busca -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:focusable="true"
                    android:id="@+id/tituloFeedback"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_secao_feedback"
                    android:textSize="20sp" />

                <TextView android:focusable="true"
                    style="@style/Texto.Apoio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/config_feedback_dica" />

                <RadioGroup
                    android:id="@+id/grupoFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioVibracao"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/config_feedback_vibracao"
                        android:textColor="@color/texto"
                        android:textSize="18sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioBips"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/config_feedback_bips"
                        android:textColor="@color/texto"
                        android:textSize="18sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioAmbos"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/config_feedback_ambos"
                        android:textColor="@color/texto"
                        android:textSize="18sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Voz do aplicativo (TTS) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:focusable="true"
                    android:id="@+id/tituloVoz"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_secao_voz"
                    android:textSize="20sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVoz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp"
                    android:text="@string/config_voz_titulo"
                    android:textColor="@color/texto"
                    android:textSize="18sp" />

                <TextView android:focusable="true"
                    style="@style/Texto.Apoio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/config_voz_explicacao" />

                <TextView android:focusable="true"
                    android:id="@+id/textoTalkback"
                    style="@style/Texto.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold" />

                <TextView android:focusable="true"
                    style="@style/Texto.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_voz_depois_leitura" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissão da câmera -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:focusable="true"
                    android:id="@+id/tituloPermissoes"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_secao_permissoes"
                    android:textSize="20sp" />

                <TextView android:focusable="true"
                    style="@style/Texto.Apoio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/config_permissoes_explicacao" />

                <TextView android:focusable="true"
                    android:id="@+id/textoCamera"
                    style="@style/Texto.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoCameraPermissao"
                    style="@style/Botao.Principal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:icon="@drawable/ic_camera" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacidade e contato -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:focusable="true"
                    android:id="@+id/tituloAjuda"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_secao_ajuda"
                    android:textSize="20sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoPolitica"
                    style="@style/Botao.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/config_botao_politica"
                    app:icon="@drawable/ic_escudo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoFeedback"
                    style="@style/Botao.Principal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/config_botao_feedback"
                    app:icon="@drawable/ic_email" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
