<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!--
      Visibilidade de pacotes (Android 11+): sem isto o app não consegue "enxergar" quais aplicativos
      abrem um atalho, então não conseguiria dizer o nome do aplicativo antes de abrir.
      Para cada atalho de aplicativo que você quiser reconhecer pelo nome, acrescente um bloco <intent>
      com o esquema dele (a parte antes de "://").
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="itauvarejo" />
        </intent>
        <!-- <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="OUTROESQUEMA" />
        </intent> -->
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_extracao_dados"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeitorQR">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfiguracoesActivity"
            android:exported="false"
            android:label="@string/titulo_configuracoes"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DicasActivity"
            android:exported="false"
            android:label="@string/titulo_dicas"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PoliticaActivity"
            android:exported="false"
            android:label="@string/titulo_politica"
            android:parentActivityName=".ConfiguracoesActivity"
            android:screenOrientation="portrait" />
    </application>
</manifest>
